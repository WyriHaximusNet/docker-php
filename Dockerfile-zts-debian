# syntax=docker/dockerfile:experimental
ARG PHP_VERSION=7.4
ARG OS_VERSION=buster
ARG SRC_IMAGE=zts
FROM php:$PHP_VERSION-$SRC_IMAGE-$OS_VERSION AS base

# Build-time metadata as defined at http://label-schema.org
LABEL org.label-schema.name="wyrihaximusnet/php" \
      org.label-schema.description="Opinionated ReactPHP optimised PHP Docker images" \
      org.label-schema.url="https://github.com/wyrihaximusnet/docker-php" \
      org.label-schema.vcs-url="https://github.com/wyrihaximusnet/docker-php" \
      org.label-schema.vendor="WyriHaximus.net" \
      org.label-schema.schema-version="1.0"

ARG ARCH=amd64

RUN set -x \
    && apt-get update \
    && yes | apt-get upgrade \
    && addgroup --gid 1000 app \
    && adduser --uid 1000 --gid 1000 --disabled-password app --home /opt/app \
    && touch /.you-are-in-a-wyrihaximus.net-php-docker-image

COPY --from=mlocati/php-extension-installer /usr/bin/install-php-extensions /usr/local/bin/

FROM base AS zts-slim-root
ARG PHP_VERSION

# Patch CVE-2018-14618 (curl), CVE-2018-16842 (libxml2), CVE-2019-1543 (openssl)
RUN yes | apt-get upgrade curl libxml2 openssl

# Install docker help scripts
COPY src/php/utils/docker/debian/ /usr/local/bin/
COPY src/php/utils/docker/docker-php-entrypoint-with-stack /usr/local/bin/docker-php-entrypoint-with-stack

COPY src/php/conf/ /usr/local/etc/php/conf.d/
COPY src/php/cli/conf/*.ini /usr/local/etc/php/conf.d/
COPY src/php/conf/available/prod.ini /usr/local/etc/php/conf.d/zzz_prod.ini

COPY --from=ghcr.io/php/pie:1.6.1-bin /pie /usr/bin/pie

RUN rm /usr/local/etc/php/conf.d/jit.ini && \
    yes | apt-get install \
        libgmp-dev \
        zlib1g-dev \
        libpq-dev \
        libzip-dev \
        libuv1-dev \
        libicu-dev \
        libonig-dev \
        libevent-dev \
        libssl-dev \
        libffi-dev \
        make \
        git \
        openssh-client \
        bash \
        coreutils \
        procps \
        git \
        wget \
        gdb \
        libtool \
        moreutils \
        $PHPIZE_DEPS \
    && docker-php-ext-install -j$(nproc) pcntl pgsql pdo pdo_pgsql bcmath zip gmp iconv intl sockets ffi mbstring \
    && if [ $(php -v | head -1 | grep -E "alpha|ALPHA|beta|BETA|rc|RC" | wc -l) != 0 ] ; then true ; else (docker-php-ext-install -j$(nproc) random || true) ; fi \
    && pie install pecl/parallel \
    && if [ $(php -v | head -1 | grep -E "alpha|ALPHA|beta|BETA|rc|RC" | wc -l) != 0 ] ; then true ; else install-php-extensions opentelemetry event ; fi \
    && if [ $(php -v | head -1 | grep -E "alpha|ALPHA|beta|BETA|rc|RC" | wc -l) != 0 ] ; then true ; else if [ $(php -v | grep "PHP 8\.[6789]" | wc -l) != 0 ] ; then true ; else install-php-extensions protobuf ; fi ; fi \
    && if [ $(php -v | head -1 | grep -E "alpha|ALPHA|beta|BETA|rc|RC" | wc -l) != 0 ] ; then true ; else install-php-extensions eio || true ; fi \
    && if [ $(php -v | grep "PHP 8\.[56789]" | wc -l) != 0 ] ; then true ; else install-php-extensions grpc; fi \
    && if [ $(php -v | head -1 | grep -E "alpha|ALPHA|beta|BETA|rc|RC" | wc -l) != 0 ] ; then true ; else docker-php-ext-enable --ini-name zzz-eio.ini eio ; fi \
    && if [ $(php -v | head -1 | grep -E "alpha|ALPHA|beta|BETA|rc|RC" | wc -l) != 0 ] ; then true ; else docker-php-ext-enable --ini-name zzzzz-event.ini event ; fi \
    && pie install amphp/uv \
    && yes | apt-get purge $PHPIZE_DEPS \
    && apt-get update && yes | apt-get install make \
    && wget -q -O - https://raw.githubusercontent.com/vishnubob/wait-for-it/master/wait-for-it.sh > /bin/wait-for \
    && chmod +x /bin/wait-for \
    && rm -rf /tmp/* \
    && chmod +x /usr/local/bin/docker-php-entrypoint-with-stack

STOPSIGNAL SIGTERM

ENTRYPOINT ["docker-php-entrypoint-with-stack"]

## ZTS-DEV STAGE ##
FROM zts-slim-root AS zts-root

# Install ext-gd and ext-vips
COPY src/php/utils/docker/debian/install-gd-and-vips /usr/local/bin/install-gd-and-vips
RUN if [ $(php -v | head -1 | grep -E "alpha|ALPHA|beta|BETA|rc|RC" | wc -l) != 0 ] ; then true ; else install-gd-and-vips; fi \
     && rm -rf /usr/local/bin/install-gd-and-vips

## ZTS-DEV STAGE ##
FROM zts-slim-root AS zts-slim-dev-root

RUN touch /.you-are-in-a-wyrihaximus.net-php-docker-image-dev

# Install docker help scripts
COPY src/php/utils/docker/debian/dev-mode /usr/local/bin/dev-mode
COPY src/php/utils/docker/debian/docker-php-dev-mode /usr/local/bin/docker-php-dev-mode
RUN if [ $(php -v | head -1 | grep -E "alpha|ALPHA|beta|BETA|rc|RC" | wc -l) != 0 ] ; then true ; else dev-mode; fi \
    && rm -rf /usr/local/bin/dev-mode \
    && rm -rf /usr/local/bin/docker-php-dev-mode \
    && yes | apt-get install make patch

# Install composer
COPY --from=composer:2 /usr/bin/composer /usr/local/bin/composer


ENTRYPOINT ["docker-php-entrypoint-with-stack"]

## ZTS-DEV STAGE ##
FROM zts-root AS zts-dev-root

RUN touch /.you-are-in-a-wyrihaximus.net-php-docker-image-dev

# Install docker help scripts
COPY src/php/utils/docker/debian/dev-mode /usr/local/bin/dev-mode
COPY src/php/utils/docker/debian/docker-php-dev-mode /usr/local/bin/docker-php-dev-mode
RUN if [ $(php -v | head -1 | grep -E "alpha|ALPHA|beta|BETA|rc|RC" | wc -l) != 0 ] ; then true ; else dev-mode; fi \
    && rm -rf /usr/local/bin/dev-mode \
    && rm -rf /usr/local/bin/docker-php-dev-mode \
    && yes | apt-get install make patch

# Install composer
COPY --from=composer:2 /usr/bin/composer /usr/local/bin/composer


ENTRYPOINT ["docker-php-entrypoint-with-stack"]

## ZTS-DEV stage ##
FROM zts-slim-dev-root AS zts-slim-dev
# hadolint ignore=DL3066
USER app

FROM zts-dev-root AS zts-dev
# hadolint ignore=DL3066
USER app

## ZTS stage ##
FROM zts-slim-root AS zts-slim
# hadolint ignore=DL3066
USER app

FROM zts-root AS zts
# hadolint ignore=DL3066
USER app
